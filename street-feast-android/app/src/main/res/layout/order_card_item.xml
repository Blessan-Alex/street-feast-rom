<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Card header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTableHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Table 05 - #1254"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badgeRunningLate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_running_late"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="RUNNING LATE"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLastUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="12 min ago"
        android:textColor="#A0A7BC"
        android:textSize="11sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#EEF0F5" />

    <!-- ORDER ITEMS -->

    <!-- Item 1 -->
    <LinearLayout
        android:id="@+id/item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Color bar -->
        <View
            android:id="@+id/colorBar1"
            android:layout_width="3dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="#F5515F" />

        <!-- Texts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItem1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spicy Ramen Burger"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItem1Qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_qty_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="x2"
                    android:textColor="#666A7A"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItem1Size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Size: Large"
                android:textColor="#6F7384"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItem1Tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tips: Extra hot sauce, no onions"
                android:textColor="#A0A7BC"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchItem1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Item 2 -->
    <LinearLayout
        android:id="@+id/item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorBar2"
            android:layout_width="3dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="#F5515F" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItem2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Truffle Fries"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItem2Qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_qty_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="x1"
                    android:textColor="#666A7A"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItem2Size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Size: Mid"
                android:textColor="#6F7384"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItem2Tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tips: Side of aioli"
                android:textColor="#A0A7BC"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchItem2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Item 3 (green bar, ON switch) -->
    <LinearLayout
        android:id="@+id/item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorBar3"
            android:layout_width="3dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="#2ECC71" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItem3Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Classic Milkshake"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItem3Qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_qty_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="x1"
                    android:textColor="#666A7A"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItem3Size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Size: Small"
                android:textColor="#6F7384"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItem3Tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tips: Vanilla"
                android:textColor="#A0A7BC"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchItem3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Item 4 -->
    <LinearLayout
        android:id="@+id/item4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorBar4"
            android:layout_width="3dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="#2ECC71" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItem4Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avocado Toast"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItem4Qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_qty_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="x1"
                    android:textColor="#666A7A"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItem4Size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Size: -"
                android:textColor="#6F7384"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItem4Tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tips: Gluten-free bread"
                android:textColor="#A0A7BC"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchItem4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Mark all prepared button -->
    <Button
        android:id="@+id/btnMarkAllPrepared"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_green_cta"
        android:text="Mark All Prepared"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>

