<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/sf_appbar_h"
    android:background="@color/sf_appbar_bg"
    android:paddingStart="@dimen/sf_pad_screen_h"
    android:paddingEnd="@dimen/sf_pad_screen_h"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Barrier for the bottom of the top row (handles GONE widgets) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierTopRowBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierAllowsGoneWidgets="true"
        app:constraint_referenced_ids="ivNavBack,tvBrand,tvDate,btnRefreshTables,btnRefreshMenu,btnLogout" />

    <!-- Helps tvBrand start after whichever icon is visible (back/handle/brand) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierLeftIconsEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:barrierAllowsGoneWidgets="true"
        app:constraint_referenced_ids="ivNavBack" />

    <!-- Helps texts end before whichever right action is visible -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierActionsStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:barrierAllowsGoneWidgets="true"
        app:constraint_referenced_ids="btnRefreshTables,btnRefreshMenu,btnLogout" />

    <ImageView
        android:id="@+id/ivNavBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_chev_left_20"
        android:contentDescription="@string/cd_navigate_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!--
   <ImageView
       android:id="@+id/ivBrand"
       android:layout_width="48dp"
       android:layout_height="48dp"
       android:layout_marginStart="4dp"
       android:background="?attr/selectableItemBackgroundBorderless"
       android:clickable="true"
       android:focusable="true"
       android:padding="8dp"
       android:src="@drawable/ic_cutlery"

       android:contentDescription="@string/cd_brand"
       app:tint="@color/sf_text_primary"
       app:layout_constraintStart_toEndOf="@id/ivNavBack"
       app:layout_constraintTop_toTopOf="@id/ivNavBack"
       app:layout_constraintBottom_toBottomOf="@id/ivNavBack" />
       -->



   <TextView
       android:id="@+id/tvBrand"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginStart="8dp"
       android:maxLines="1"
       android:ellipsize="end"
       android:text="@string/street_feast"
       android:textColor="@color/sf_text_primary"
       android:textSize="18sp"
       android:textStyle="bold"
       app:layout_constraintStart_toEndOf="@id/barrierLeftIconsEnd"

       app:layout_constraintTop_toTopOf="@id/ivNavBack"
       app:layout_constraintBottom_toBottomOf="@id/ivNavBack"
       tools:ignore="NotSibling" />





   <FrameLayout
       android:id="@+id/btnRefreshTables"
       android:layout_width="48dp"
       android:layout_height="48dp"
       android:layout_marginEnd="4dp"
       android:background="@drawable/sf_bg_circle_light"
       android:clickable="true"
       android:focusable="true"
       android:contentDescription="@string/cd_refresh_table_status"
       android:visibility="gone"
       app:layout_constraintEnd_toStartOf="@id/btnRefreshMenu"
       app:layout_constraintTop_toTopOf="@id/ivNavBack"
       app:layout_constraintBottom_toBottomOf="@id/ivNavBack">

       <ImageView
           android:id="@+id/ivRefreshTables"
           android:layout_width="20dp"
           android:layout_height="20dp"
           android:layout_gravity="center"
           android:src="@drawable/ic_refresh" />
   </FrameLayout>

   <FrameLayout
       android:id="@+id/btnRefreshMenu"
       android:layout_width="48dp"
       android:layout_height="48dp"
       android:layout_marginEnd="4dp"
       android:background="@drawable/sf_bg_circle_light"
       android:clickable="true"
       android:focusable="true"
       android:contentDescription="@string/cd_refresh_menu"
       android:visibility="gone"
       app:layout_constraintEnd_toStartOf="@id/btnLogout"
       app:layout_constraintTop_toTopOf="@id/ivNavBack"
       app:layout_constraintBottom_toBottomOf="@id/ivNavBack">

       <ImageView
           android:id="@+id/ivRefreshMenu"
           android:layout_width="20dp"
           android:layout_height="20dp"
           android:layout_gravity="center"
           android:src="@drawable/ic_refresh" />
   </FrameLayout>

   <FrameLayout
       android:id="@+id/btnLogout"
       android:layout_width="48dp"
       android:layout_height="48dp"
       android:background="@drawable/sf_bg_circle_light"
       android:clickable="true"
       android:focusable="true"
       android:contentDescription="@string/cd_logout"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toTopOf="@id/ivNavBack"
       app:layout_constraintBottom_toBottomOf="@id/ivNavBack">

       <ImageView
           android:layout_width="20dp"
           android:layout_height="20dp"
           android:layout_gravity="center"
           android:src="@drawable/logout_24px" />
   </FrameLayout>

   <TextView
       android:id="@+id/tvTitle"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:layout_marginBottom="12dp"
       android:text="@string/waiter_page"
       android:textColor="@color/sf_text_primary"
       android:textSize="34sp"
       android:textStyle="bold"
       android:maxLines="2"
       android:ellipsize="end"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toBottomOf="@id/barrierTopRowBottom"
       app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
